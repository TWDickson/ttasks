{
  "extends": "@tsconfig/svelte",
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "lib": ["ES6", "ES2016", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "allowJs": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true
  },
  // test-rig is in the type-check on purpose. It builds its own plugin mock
  // against the real component props, so a change to the plugin surface can
  // break it while `src` stays green — that happened (statusPolicy, 2026-08-06)
  // and only showed up as a blank page when the rig was run by hand.
  // `tsc --noEmit` here has no effect on the shipped bundle (esbuild builds from
  // its own entry), so this costs nothing but a few seconds in `npm run check`.
  // `**/*.ts` deliberately excludes the `.mts` build tooling (vite.config.mts,
  // vault-data-plugin.mts), which is Node-side config rather than rig code.
  "include": ["src/**/*.ts", "src/**/*.svelte", "test-rig/**/*.ts"]
}
